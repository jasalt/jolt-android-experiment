#!/usr/bin/env bash
# Build the reduced Jolt ARM64 Android library experiment from a pinned Jolt
# checkout. Run inside `nix develop`; set JOLT_SOURCE to a Jolt checkout at the
# revision pinned by flake.nix.
set -euo pipefail

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
jolt_source="${JOLT_SOURCE:?set JOLT_SOURCE to the pinned Jolt checkout}"
chez_source="$root/.cache/chezscheme-v10.4.1"
revision="8fcba79f8b33628af926f88032d93a1b31c24235"
patch="$root/experiments/EXP-004-jolt-android-library-cross-target/jolt-cross-library.patch"
poc="$root/experiments/EXP-004-jolt-android-library-cross-target/poc"
output="$root/native/jolt/android-arm64/arm64-v8a/libjoltpoc.so"

[[ "$(git -C "$jolt_source" rev-parse HEAD)" == "$revision" ]] || {
  echo "JOLT_SOURCE must be at $revision" >&2
  exit 1
}
[[ -x "$chez_source/ta6le/bin/ta6le/scheme" ]] || {
  echo "missing pinned Chez host compiler: $chez_source" >&2
  exit 1
}
[[ -x "${ANDROID_NDK_ROOT:?run inside nix develop}/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang" ]] || {
  echo "missing Android NDK r29 ARM64 compiler" >&2
  exit 1
}

work="$(mktemp -d)"
pack="$work/tarm64le-pack"
trap 'git -C "$jolt_source" worktree remove --force "$work/jolt" 2>/dev/null || true; rm -rf "$work"' EXIT

git -C "$jolt_source" worktree add --detach "$work/jolt" "$revision" >/dev/null
git -C "$work/jolt" submodule update --init --recursive
(
  cd "$work/jolt"
  # The stored patch uses a marker for blank unified-diff context lines so the
  # project-wide whitespace gate can remain strict; restore it only in /tmp.
  sed 's/^__JOLT_PATCH_CONTEXT_BLANK__$/ /' "$patch" > "$work/jolt-cross-library.patch"
  git apply "$work/jolt-cross-library.patch"
)
CHEZ_SRC="$chez_source" "$work/jolt/tools/cross-compile/make-pack.sh" tarm64le "$pack"
# Android/Bionic has neither librt nor libpthread; EXP-003 established this
# reduced set for the exact PIC Chez kernel staged in the target pack.
printf '%s\n' '-llz4 -lz -lm -ldl' > "$pack/link-libs"

mkdir -p "$(dirname "$output")"
rm -rf "$work/libjoltpoc.so.build"
JOLT_PWD="$poc" \
JOLT_CHEZ="$chez_source/ta6le/bin/ta6le/scheme" \
JOLT_CHEZ_CSV="$chez_source/ta6le/boot/ta6le" \
SCHEMEHEAPDIRS="$chez_source/ta6le/boot/ta6le" \
JOLT_TARGET_CC="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android35-clang" \
JOLT_TARGET_LINK_LIBS="-L$pack/lib -llz4 -lz -lm -ldl" \
"$work/jolt/bin/jolt" build --library -m poc.native -o "$work/libjoltpoc.so" \
  --target tarm64le --target-pack "$pack"

install -Dm755 "$work/libjoltpoc.so" "$output"
file "$output"
readelf -d "$output" | grep NEEDED
nm -D --defined-only "$output" | grep -E 'jolt_library_(init|lookup|collect|shutdown)'
