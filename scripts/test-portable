#!/usr/bin/env bash
# Run portable unit and CLI fixture tests from the pinned Nix shell.
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

jolt -M:test

actual=$(./scripts/cli --event '{:type :counter/inc}')
expected='{:model {:counter 1, :events [], :platform nil, :lifecycle nil, :worker nil, :notification-permission nil}, :effects [{:type :storage/write, :key "counter", :value 1}]}'
if [[ "$actual" != "$expected" ]]; then
  printf 'unexpected CLI output:\nexpected: %s\nactual:   %s\n' "$expected" "$actual" >&2
  exit 1
fi

malformed=$(./scripts/cli --event '{not EDN')
if [[ "$malformed" != *":wire/malformed"* ]]; then
  printf 'malformed EDN did not return canonical wire error: %s\n' "$malformed" >&2
  exit 1
fi
