#!/usr/bin/env bash
# Exercise lifecycle/recreation/process restart on the running API-35 AVD.
set -euo pipefail
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${ANDROID_HOME:?run through nix develop so ANDROID_HOME is set}"
serial="emulator-${JOLT_ANDROID_EMULATOR_PORT:-5554}"
pkg=${JOLT_ANDROID_PACKAGE:-net.joltlang.androidpoc.abiprobe}
activity="$pkg/.MainActivity"
[[ "$(adb -s "$serial" get-state 2>/dev/null)" == device ]] || { echo 'AVD unavailable' >&2; exit 1; }
mkdir -p "$root/artifacts/layouts" "$root/artifacts/logs"
adb -s "$serial" shell am force-stop "$pkg"
adb -s "$serial" shell am start -W -n "$activity" >/dev/null
sleep 2
for i in 1 2 3; do
  adb -s "$serial" shell input keyevent 26
  sleep 1
  adb -s "$serial" shell input keyevent 26
  sleep 1
  adb -s "$serial" shell am force-stop "$pkg"
  adb -s "$serial" shell am start -W -n "$activity" >/dev/null
  sleep 1
done
adb -s "$serial" shell uiautomator dump /sdcard/jolt-lifecycle.xml >/dev/null
adb -s "$serial" exec-out cat /sdcard/jolt-lifecycle.xml > "$root/artifacts/layouts/lifecycle.xml"
grep -F 'initialized=true' "$root/artifacts/layouts/lifecycle.xml" >/dev/null
grep -F ':lifecycle :resumed' "$root/artifacts/layouts/lifecycle.xml" >/dev/null
adb -s "$serial" logcat -d -v threadtime > "$root/artifacts/logs/lifecycle.log"
if grep -Eq 'FATAL EXCEPTION|SIGABRT|signal 6' "$root/artifacts/logs/lifecycle.log"; then exit 1; fi
printf 'Lifecycle smoke passed; layout and log written under artifacts/\n'
