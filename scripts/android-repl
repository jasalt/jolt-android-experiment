#!/usr/bin/env bash
# Send one caller-supplied form to the debug-only loopback eval server.
# This is interactive eval, not nREPL/CIDER or a redefinition protocol.
set -euo pipefail
: "${ANDROID_HOME:?run through nix develop so ANDROID_HOME is set}"
port=${JOLT_ANDROID_EMULATOR_PORT:-5554}; serial="emulator-$port"
local_port=${JOLT_ANDROID_REPL_PORT:-45678}
[[ $# -eq 1 ]] || { echo "usage: $0 '<Jolt form>'" >&2; exit 2; }
[[ "$(adb -s "$serial" get-state 2>/dev/null)" == device ]] || { echo "AVD unavailable: $serial" >&2; exit 1; }
adb -s "$serial" forward "tcp:$local_port" "tcp:45678" >/dev/null
# Android's ADB forwarding keeps the TCP connection open after the one-line
# response, so use a bounded Python client rather than waiting for EOF.
command -v python3 >/dev/null || { echo 'missing python3 for framed TCP client' >&2; exit 1; }
python3 -c 'import socket,sys; s=socket.create_connection(("127.0.0.1",int(sys.argv[1])),5); s.settimeout(10); s.sendall((sys.argv[2]+"\n").encode()); print(s.makefile().readline(),end=""); s.close()' "$local_port" "$1"
