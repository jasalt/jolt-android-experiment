#!/usr/bin/env bash
# Run the Linux GTK4 reference host through the pinned Nix shell:
#   DISPLAY=:99 nix develop -c ./scripts/gtk-run
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

mkdir -p target
: "${DISPLAY:?set DISPLAY to a GTK-capable X11 display (the Lima desktop uses :99)}"
exec jolt run -m poc.gtk-app "$@"
