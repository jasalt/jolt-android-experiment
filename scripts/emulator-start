#!/usr/bin/env bash
# Create (once) and start the pinned API 35 AVD.
# Usage: nix develop -c ./scripts/emulator-start {gui|headless|software}
set -euo pipefail

mode=${1:-headless}
case "$mode" in
  gui|headless|software) ;;
  *)
    printf 'usage: %s {gui|headless|software}\n' "$0" >&2
    exit 2
    ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
: "${ANDROID_HOME:?run through nix develop so ANDROID_HOME is set}"
: "${ANDROID_AVD_HOME:?run through nix develop so ANDROID_AVD_HOME is set}"

case "$(uname -m)" in
  x86_64)
    avd_abi=x86_64
    avd_cpu_arch=x86_64
    default_avd_name=jolt_api_35_x86_64
    default_gpu=angle
    ;;
  arm64|aarch64)
    avd_abi=arm64-v8a
    avd_cpu_arch=arm64
    default_avd_name=jolt_api_35_arm64_v8a
    default_gpu=host
    ;;
  *)
    printf 'unsupported host architecture: %s\n' "$(uname -m)" >&2
    exit 1
    ;;
esac

avd_name=${JOLT_ANDROID_AVD_NAME:-$default_avd_name}
port=${JOLT_ANDROID_EMULATOR_PORT:-5554}
gpu=${JOLT_ANDROID_EMULATOR_GPU:-$default_gpu}
serial="emulator-$port"
system_image="system-images;android-35;google_apis;$avd_abi"
device=${JOLT_ANDROID_AVD_DEVICE:-pixel_6}
log_dir="$repo_root/artifacts/logs"
report_dir="$repo_root/artifacts/reports"
log_file="$log_dir/$avd_name.log"
report_file="$report_dir/emulator-$avd_name.txt"

mkdir -p "$ANDROID_AVD_HOME" "$log_dir" "$report_dir"
export ANDROID_EMULATOR_HOME="$ANDROID_AVD_HOME"
export ANDROID_USER_HOME="$repo_root/.android"

emulator_pid=''
if adb -s "$serial" get-state >/dev/null 2>&1; then
  printf '%s is already running\n' "$serial"
else
  avd_config="$ANDROID_AVD_HOME/$avd_name.avd/config.ini"
  if [[ ! -f "$ANDROID_AVD_HOME/$avd_name.ini" ]]; then
    printf 'Creating AVD %s with %s\n' "$avd_name" "$system_image"
    printf 'no\n' | avdmanager create avd --force \
      --name "$avd_name" \
      --package "$system_image" \
      --device "$device" \
      --path "$ANDROID_AVD_HOME/$avd_name.avd"
  fi
  if ! grep -aFxq "abi.type=$avd_abi" "$avd_config" || \
      ! grep -aFxq "hw.cpu.arch=$avd_cpu_arch" "$avd_config"; then
    printf 'AVD %s is not a valid %s configuration; recreate it under %s\n' \
      "$avd_name" "$avd_abi" "$ANDROID_AVD_HOME" >&2
    exit 1
  fi

  emulator_args=(
    "@$avd_name"
    -port "$port"
    -no-snapshot
    -no-snapshot-save
    -no-boot-anim
    -noaudio
    -no-metrics
    -gpu "$gpu"
    -memory "${JOLT_ANDROID_EMULATOR_MEMORY_MB:-1024}"
  )
  case "$mode" in
    gui)
      : "${DISPLAY:?GUI mode requires DISPLAY; use headless or software otherwise}"
      emulator_args+=(-accel auto)
      ;;
    headless)
      emulator_args+=(-no-window -accel auto)
      ;;
    software)
      emulator_args+=(-no-window -accel off)
      ;;
  esac

  printf 'Starting %s (%s, gpu=%s); log: %s\n' "$avd_name" "$mode" "$gpu" "$log_file"
  nohup emulator "${emulator_args[@]}" >"$log_file" 2>&1 &
  emulator_pid=$!
fi

booted=0
for _ in $(seq 1 180); do
  if [[ "$(adb -s "$serial" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]]; then
    booted=1
    break
  fi
  if [[ -n "$emulator_pid" ]] && ! kill -0 "$emulator_pid" 2>/dev/null; then
    printf 'Emulator exited before boot; see %s\n' "$log_file" >&2
    exit 1
  fi
  sleep 1
done

if [[ "$booted" != 1 ]]; then
  printf 'Emulator did not boot within 180 seconds; see %s\n' "$log_file" >&2
  exit 1
fi

{
  printf '# API 35 emulator report\n\n'
  printf 'Generated UTC: '
  date -u '+%Y-%m-%dT%H:%M:%SZ'
  printf 'Mode: %s\n' "$mode"
  printf 'GPU: %s\n' "$gpu"
  printf 'AVD: %s\n' "$avd_name"
  printf 'Serial: %s\n\n' "$serial"
  printf '## Acceleration\n\n'
  emulator -accel-check
  printf '\n## Device\n\n'
  adb -s "$serial" shell getprop ro.build.version.sdk
  adb -s "$serial" shell getprop ro.product.cpu.abi
  adb -s "$serial" shell getprop ro.product.cpu.abilist
  adb -s "$serial" shell getprop ro.kernel.qemu
  adb -s "$serial" shell getprop ro.build.version.release
} >"$report_file" 2>&1

printf 'Booted %s; wrote %s\n' "$serial" "$report_file"
