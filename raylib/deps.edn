{:paths ["src" "test"]

 ;; This declaration is only the desktop run/build-image host. The reusable
 ;; namespace has no native declaration, so Android symbol topology remains a
 ;; separate evidence-gated decision rather than an accidental dependency.
 :jolt/native [{:name "raylib desktop"
                :linux ["libraylib.so.6" "libraylib.so"]}]

 :aliases
 {:check {:main-opts ["-e" "(println \"Raylib host dependency manifest parsed\")"]}
  :test {:main-opts ["-m" "poc.raylib.test-runner"]}
  :minimal-smoke {:main-opts ["-m" "poc.raylib.minimal"]}}}
