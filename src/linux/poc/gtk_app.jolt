(ns poc.gtk-app
  "Linux GTK4 reference host for the portable reducer.

  Authoritative reducer state and adapter diagnostics live in separate Glimmer
  reactive cells. GTK widgets render the shared view model and translate user
  interaction into portable events; the reducer neither sees GTK pointers nor
  executes GTK effects."
  (:require [clojure.edn :as edn]
            [glimmer.ratom :refer [atom]]
            [glimmer.core :as ui]
            [glimmer-gtk.core]
            [jolt.ffi :as ffi]
            [poc.conformance :as conformance]
            [poc.contracts :as contracts]
            [poc.reducer :as reducer]
            [poc.wire :as wire]))

(defn storage-file []
  (or (System/getenv "POC_GTK_STATE_FILE") "target/gtk-counter.edn"))

(defn stored-counter []
  (try
    (let [value (edn/read-string (slurp (storage-file)))]
      (when (number? value) value))
    (catch :default _ nil)))

(defn initial-model []
  (let [counter (stored-counter)
        restored (if (some? counter)
                   (first (reducer/step reducer/initial-state
                                        {:type :storage/restore :value counter}))
                   reducer/initial-state)]
    (first (reducer/step restored
                         {:type :platform/info
                          :value (contracts/platform-description
                                   :linux
                                   {:persistence :available
                                    :clipboard :session-dependent
                                    :open-uri :request-only})}))))

;; These narrow FFI bindings deliberately remain in the Linux adapter.  The
;; shared contracts namespace uses only EDN data and never receives GTK values.
(ffi/defcfn gdk-display-get-default "gdk_display_get_default" [] :pointer)
(ffi/defcfn gdk-display-get-clipboard "gdk_display_get_clipboard" [:pointer] :pointer)
(ffi/defcfn gdk-clipboard-set-text "gdk_clipboard_set_text" [:pointer :string] :void)
(ffi/defcfn gtk-show-uri "gtk_show_uri" [:pointer :string :uint] :void)

;; Keep authoritative reducer data and adapter diagnostics in separate cells.
;; defonce lets reducer state survive component redefinition plus ui/reload! in
;; the documented nREPL workflow.
(defonce app-state (atom (initial-model)))
(defonce adapter-state
  (atom {:last-effects [] :effect-results []}))

(defn copy-to-clipboard! [text]
  (let [display (gdk-display-get-default)]
    (if (= display ffi/null)
      :unavailable
      (let [clipboard (gdk-display-get-clipboard display)]
        (if (= clipboard ffi/null)
          :unavailable
          (do (gdk-clipboard-set-text clipboard text) :requested))))))

(defn open-uri! [uri]
  ;; A nil parent makes this host operation independent of widget/domain state.
  ;; gtk_show_uri only confirms that GTK accepted the request; the desktop may
  ;; still lack a portal/browser, as the Xvfb evidence demonstrates.
  (gtk-show-uri ffi/null uri 0)
  :requested)

(defn execute-effect! [{:keys [type key value text uri]}]
  (case type
    :storage/write (if (= key "counter")
                     (do (spit (storage-file) (pr-str value)) :completed)
                     :unsupported)
    :platform/clipboard (copy-to-clipboard! text)
    :platform/open-uri (open-uri! uri)
    :unsupported))

(defn execute-effect-safely! [effect]
  (try
    {:effect-type (:type effect) :status (execute-effect! effect)}
    (catch :default error
      {:effect-type (:type effect) :status :failed :message (str error)})))

(defn execute-effects! [effects]
  (mapv execute-effect-safely! effects))

(defn dispatch! [event]
  (let [[model effects] (reducer/step @app-state event)]
    ;; Commit the pure transition first. Adapter failures are diagnostics and do
    ;; not roll back or contaminate authoritative reducer state.
    (reset! app-state model)
    (reset! adapter-state
            {:last-effects effects
             :effect-results (execute-effects! effects)})
    (wire/encode-response {:model model :effects effects})))

(defn dispatch-wire! [event-wire]
  (let [decoded (wire/decode-event event-wire)]
    (if-let [event (:ok decoded)]
      (dispatch! event)
      (wire/encode-response decoded))))

(defn- platform-label [platform]
  (if platform (pr-str platform) "Linux x86_64"))

(defn app []
  (let [model (reducer/view-model @app-state)
        adapter @adapter-state]
    [:vbox {:spacing 12 :margin 18}
     [:label {:markup [:span {:weight "bold" :size "x-large"}
                       "Jolt Mobile PoC"]}]
     [:label {:label (str "Platform: " (platform-label (:platform model)))}]
     [:label {:label "Runtime: Jolt / Chez"}]
     [:separator {}]
     [:label {:label (str "Counter: " (:counter model))}]
     [:hbox {:spacing 8}
      [:button {:label "−" :on-click #(dispatch! {:type :counter/dec})}]
      [:button {:label "+" :on-click #(dispatch! {:type :counter/inc})}]
      [:button {:label "Reset" :on-click #(dispatch! {:type :counter/reset})}]]
     [:separator {}]
     [:label {:label "Shared model:"}]
     [:label {:label (str "Events: " (:event-count model))}]
     [:label {:label (str "Lifecycle: " (:lifecycle model))}]
     [:label {:label (str "Worker: " (:worker model))}]
     [:label {:label (str "Effects: " (pr-str (:last-effects adapter)))}]
     [:label {:label (str "Adapter outcomes: "
                          (pr-str (:effect-results adapter)))}]
     [:hbox {:spacing 8}
      [:button {:label "Copy counter"
                :on-click #(dispatch! {:type :platform/copy-counter})}]
      [:button {:label "Open Jolt site"
                :on-click #(dispatch! {:type :platform/open-url})}]]]))

(defn -main [& args]
  (if (= ["--conformance"] args)
    (do (reset! app-state reducer/initial-state)
        (reset! adapter-state {:last-effects [] :effect-results []})
        (println (pr-str (conformance/verify! dispatch-wire!))))
    (ui/run app :title "Jolt Mobile PoC" :width 520 :height 360
            :app-id "net.joltlang.androidpoc.gtk")))
