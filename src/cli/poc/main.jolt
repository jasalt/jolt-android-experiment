(ns poc.main
  (:require [poc.reducer :as reducer]
            [poc.wire :as wire]))

(defn -main [& args]
  (if (and (= 2 (count args)) (= "--event" (first args)))
    (let [decoded (wire/decode-event (second args))]
      (if-let [event (:ok decoded)]
        (let [[model effects] (reducer/step reducer/initial-state event)]
          (println (wire/encode-response {:model model :effects effects})))
        (println (wire/encode-response decoded))))
    (throw (ex-info "usage: cli --event '<EDN event map>'" {:args args}))))
